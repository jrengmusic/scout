        <type>juce::StringArray</type>
        <definition>juce::StringArray Toolchain::getToolchainArguments</definition>
        <argsstring>(const juce::String &amp;command, const juce::String &amp;flag)</argsstring>
        <name>getToolchainArguments</name>
        <qualifiedname>Toolchain::getToolchainArguments</qualifiedname>
        <param>
          <type>const juce::String &amp;</type>
          <declname>command</declname>
        </param>
        <param>
