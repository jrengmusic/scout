        <argsstring>(const juce::Identifier &amp;benchmarkType, const jam::HashMap&lt; juce::Identifier, juce::Array&lt; juce::var &gt; &gt; &amp;samples, const jam::HashMap&lt; juce::Identifier, int &gt; &amp;calls, const jam::HashMap&lt; juce::Identifier, juce::String &gt; &amp;units, const juce::ValueTree &amp;baselineProfile)</argsstring>
